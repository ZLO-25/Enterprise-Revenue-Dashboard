  "frequency": "quarterly",
  "lede": "艾司摩爾（ASML）是荷蘭的半導體設備公司，製造 EUV（極紫外光）微影機，也賣 DUV 微影機、量測檢測設備，以及「裝機服務」（Installed Base Management：維修、升級、選配）。客戶是晶圓代工、邏輯與記憶體晶片廠。本頁收錄 2009 年第一季起每一季的營收、利潤率、淨利、EPS、現金流。ASML 是外國發行人：不申報 10-Q，每季用 6-K 附上財報新聞稿與 US GAAP 季度彙總表，每年再申報 20-F。金額單位是百萬歐元；EPS 是 US GAAP 稀釋 EPS（歐元）。",
  "cadence": [
   {
    "when": "1、4、7、10 月中",
    "what": "財報新聞稿與投資人電話會議（6-K）",
    "which": "營收、毛利率、淨利、EPS、季度彙總損益表／資產負債表／現金流量表、下一季與全年財測、股利與買回"
   },
   {
    "when": "每年 2 月左右",
    "what": "20-F 年報",
    "which": "經查核的全年財報與附註（本站用來核對四季加總）"
   },
   {
    "when": "不定期",
    "what": "新聞稿、投資人日",
    "which": "併購、產能計畫、長期營收目標"
   }
  ]
