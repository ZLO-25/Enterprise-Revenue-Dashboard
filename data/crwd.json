   },
   {
    "when": "財報後 1–2 天",
    "what": "10-Q／10-K",
    "which": "完整財報與附註"
   },
   {
    "when": "財報前約一個月",
    "what": "公告財報日期",
    "which": "下一次財報公布日"
   }
  ]
