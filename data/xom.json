   {
    "when": "1、4、7、10 月底到 2 月初",
    "what": "財報新聞稿與電話會議（8-K 附件 99.1）",
    "which": "獲利、各部門獲利、產量、現金流、資本支出、股東回饋"
   },
   {
    "when": "財報後幾天",
    "what": "10-Q／10-K",
    "which": "完整財報、資產負債表與附註"
   },
   {
    "when": "每季",
    "what": "董事會宣告股利",
    "which": "每股股利（本頁用實際發放基準）"
   },
   {
    "when": "每年 12 月",
    "what": "企業計畫更新",
    "which": "未來幾年的資本支出、產量與回購計畫"
   }
  ]
